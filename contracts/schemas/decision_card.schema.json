{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planbench.local/contracts/schemas/decision_card.schema.json",
  "title": "Decision Card",
  "description": "CONTRACTS HĐ-12. The output every other layer serves. This file is the machine-checkable form of that section: a card that does not validate here is not a Decision Card, whoever produced it. Kept separate from the Pydantic models on purpose — the models say what this codebase builds, the schema says what the contract requires of anyone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contracts_version",
    "recommendation_scope",
    "experiment_scope",
    "decision_mode",
    "decision_mode_label",
    "status",
    "recommended",
    "alternative",
    "gates",
    "objectives",
    "decision_utility",
    "pareto_label",
    "evidence",
    "declared_assumptions",
    "manifest_ref",
    "approval"
  ],
  "properties": {
    "contracts_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Rules this card was produced under (HĐ-13)."
    },
    "recommendation_scope": {
      "enum": [
        "MISSION_LEVEL",
        "DEPLOYMENT_LEVEL",
        "ROBUST_DEPLOYMENT_LEVEL"
      ],
      "description": "Computed from the data actually provided (HĐ-2.2), never taken from the author's wish."
    },
    "experiment_scope": {
      "enum": [
        "global_planner_selection",
        "local_controller_selection",
        "full_stack_selection"
      ],
      "description": "What the run is allowed to conclude (HĐ-1.4)."
    },
    "decision_mode": {
      "enum": [
        "technical",
        "business_adjusted"
      ]
    },
    "decision_mode_label": {
      "type": "string",
      "minLength": 1,
      "description": "The sentence HĐ-9.3 requires for this mode, verbatim."
    },
    "status": {
      "enum": [
        "CLEAR_RECOMMENDATION",
        "NEAR_EQUIVALENT"
      ]
    },
    "recommended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "stack",
        "params_ref"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "string",
          "minLength": 1
        },
        "params_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "alternative": {
      "description": "Only ever a candidate labelled PARETO_FRONTIER (HĐ-12). Null until that analysis has run — the statistical runner-up is not an alternative.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id",
            "reason"
          ],
          "properties": {
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "description": "Every candidate that was evaluated, passing or not (HĐ-10.1: nobody disappears from the report).",
      "items": {
        "$ref": "#/$defs/gateRow"
      }
    },
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "U_R",
        "U_S",
        "U_E",
        "U_C"
      ],
      "description": "Set-level objectives (HĐ-9.1): U_R scores the success rate against the deployment's declared floor, not the per-episode average.",
      "properties": {
        "U_R": {
          "$ref": "#/$defs/unitInterval"
        },
        "U_S": {
          "$ref": "#/$defs/unitInterval"
        },
        "U_E": {
          "$ref": "#/$defs/unitInterval"
        },
        "U_C": {
          "$ref": "#/$defs/unitInterval"
        }
      }
    },
    "decision_utility": {
      "$ref": "#/$defs/unitInterval"
    },
    "pareto_label": {
      "enum": [
        "PARETO_FRONTIER",
        "LIKELY_DOMINATED",
        "UNCERTAIN_DOMINANCE"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta_u_vs_second",
        "delta_u_mean",
        "ci95",
        "n_episodes",
        "effect_size"
      ],
      "properties": {
        "delta_u_vs_second": {
          "type": "number",
          "description": "Median paired ΔU against the runner-up (HĐ-11.2)."
        },
        "delta_u_mean": {
          "type": "number",
          "description": "Mean paired delta-U. The statistic ci95 is the interval of (HĐ-11.2 bootstraps the mean); delta_u_vs_second is the median. Both are printed so a reader cannot mistake the interval for the median's."
        },
        "ci95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "Paired bootstrap interval of the difference. Never two candidates' overlapping intervals (§17 ban 5)."
        },
        "n_episodes": {
          "type": "integer",
          "minimum": 1
        },
        "effect_size": {
          "type": [
            "number",
            "null"
          ],
          "description": "Paired Cohen's d_z. Null when every episode gave the identical difference, where the standardised effect is undefined."
        },
        "weight_stability_margin": {
          "type": [
            "number",
            "null"
          ],
          "description": "Phase 5.3. Null means not measured — never a default that reads as 'measured and stable'."
        },
        "anchor_stability": {
          "type": [
            "string",
            "null"
          ]
        },
        "robustness_margin": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "declared_assumptions": {
      "description": "Null in technical mode. In business_adjusted, every assumption the figures were adjusted by (HĐ-9.3).",
      "type": [
        "object",
        "null"
      ]
    },
    "manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "by",
        "at",
        "comment"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "gateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6"
      ],
      "description": "All six gates, always, with the run count behind them (HĐ-15.1 criterion 3).",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "G1": {
          "$ref": "#/$defs/verdict"
        },
        "G2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "observed",
            "n_runs",
            "n_distinct_episodes",
            "upper_bound_95",
            "n_min",
            "statement"
          ],
          "properties": {
            "result": {
              "$ref": "#/$defs/verdict"
            },
            "observed": {
              "type": "integer",
              "minimum": 0
            },
            "n_runs": {
              "type": "integer",
              "minimum": 1
            },
            "n_distinct_episodes": {
              "type": "integer",
              "minimum": 1,
              "description": "Episodes that actually differ from one another, and the denominator the rule-of-three bound is computed on. The rule assumes independent draws; a deterministic stack whose traffic never crosses its route replays one episode per seed, and n_runs would then report evidence that does not exist (HĐ-7.1)."
            },
            "n_min": {
              "type": "integer",
              "minimum": 1
            },
            "upper_bound_95": {
              "type": [
                "number",
                "null"
              ],
              "description": "The rule of three applies to zero-event data only; null once a collision has been observed."
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "description": "The sentence HĐ-7.1 mandates, so the bound travels with the claim."
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "G3": {
          "$ref": "#/$defs/verdict"
        },
        "G4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "status",
            "p99_ms",
            "threshold_ms",
            "caveat"
          ],
          "properties": {
            "result": {
              "$ref": "#/$defs/verdict"
            },
            "status": {
              "const": "screened_on_host",
              "description": "verified_on_target is absent by the sim-only reservation (HĐ-7.2, §17 ban 12)."
            },
            "p99_ms": {
              "type": "number",
              "minimum": 0
            },
            "threshold_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "caveat": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "G5": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "status",
            "memory_estimate_mb",
            "available_ram_mb",
            "peak_rss_mb_diagnostic",
            "note"
          ],
          "properties": {
            "result": {
              "$ref": "#/$defs/verdict"
            },
            "status": {
              "enum": [
                "estimated_from_structure",
                "declared_by_author"
              ]
            },
            "memory_estimate_mb": {
              "type": "number",
              "minimum": 0
            },
            "available_ram_mb": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "peak_rss_mb_diagnostic": {
              "type": "number",
              "minimum": 0,
              "description": "Diagnostic only. Never compared with available_ram_mb (§17 ban 13) — hence the name."
            },
            "target_implementation": {
              "type": [
                "string",
                "null"
              ]
            },
            "bytes_per_search_node": {
              "type": [
                "integer",
                "null"
              ]
            },
            "peak_search_nodes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "G6": {
          "$ref": "#/$defs/verdict"
        }
      }
    }
  }
}
