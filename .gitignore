# =============================================================
# PlanBench — files that must never be committed
#
# Rule of thumb: anything a tool can regenerate (caches, builds,
# installed dependencies) or anything produced by a run (artifacts,
# logs, tracking data) stays out. Source, tests, docs and lockfiles
# go in.
# =============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, lint and type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml

# ---------- Node / Next.js (apps/web) ----------
node_modules/
.next/
out/
.turbo/
.vercel/
next-env.d.ts
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# ---------- ROS2 workspace (added in M7) ----------
# colcon regenerates all of these from src/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
# Root-anchored: only if colcon is run from the repo root, so a
# legitimate "log" folder deeper in the tree is not swallowed.
/install/
/log/
.colcon/

# ---------- Secrets and environment ----------
# Never commit real credentials. Only the example template is tracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# ---------- Run output: artifacts, tracking, models ----------
# Trajectories, benchmark reports and episode JSON (decision D15:
# artifacts live in storage, the repo keeps only code).
artifacts/*
# Three exceptions, each a few kB of JSON. The Decision Card and the
# manifest of a run: HĐ-15.1 makes the vertical slice an acceptance
# record and HĐ-13 makes the manifest the thing somebody else rebuilds
# the card from — an acceptance record nobody can open is not one. And
# the Measurement Report, which is the same argument for the other
# artifact: a run with one candidate produces no card (ΔU, its interval
# and its label do not exist for one), so its acceptance record is this
# file, and it was ignored here until the exception was widened.
# The Parquet traces they were computed from stay out, which is what D15
# was actually about (they are megabytes per episode).
!artifacts/runs/
artifacts/runs/*
!artifacts/runs/*/
artifacts/runs/*/*
!artifacts/runs/*/*/
artifacts/runs/*/*/*
!artifacts/runs/*/*/decision_card.json
!artifacts/runs/*/*/manifest.json
!artifacts/runs/*/*/measurement_report.json
# And a fourth: SUPERSEDED.md, the marker saying a stored run must not be
# read as a current result. A run cannot be un-run, so a card that turned
# out to rest on a broken assumption can only be marked, never corrected
# — and a marker that does not travel with the file it marks protects
# nobody.
!artifacts/runs/*/*/SUPERSEDED.md
# MLflow local tracking store and its SQLite backend
mlruns/
mlflow.db
mlartifacts/
# Trained RL checkpoints and TensorBoard output (M6).
# Stable-Baselines3 writes models as .zip, so the pattern is scoped to
# the model folders rather than banning every .zip in the repo.
ml/checkpoints/
ml/runs/
ml/**/*.zip
models/
*.pt
*.pth
*.ckpt
tensorboard/

