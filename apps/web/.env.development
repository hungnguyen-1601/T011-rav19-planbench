# `next dev` only. Keeps the dev server pointing at the backend on its
# usual port, which is what `API_BASE` used to hardcode before the
# desktop build made the fallback same-origin.
#
# Not loaded by `next build` (that reads `.env.production`), so the
# Docker image keeps taking the value from its build arg and the
# desktop export keeps falling back to its own origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
