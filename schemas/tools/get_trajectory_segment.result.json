          "unit": "m"
        },
        "n_samples": {
          "description": "Pose samples inside the segment.",
          "type": "number",
          "unit": "count"
        },
        "segment_length_m": {
          "description": "Arc length of the segment on the line.",
          "type": "number",
          "unit": "m"
        }
      },
      "required": [
        "segment_length_m",
        "n_samples",
        "max_lateral_offset_m"
      ],
      "type": "object"
    },
    "references": {
      "allOf": [
        {
          "contains": {
