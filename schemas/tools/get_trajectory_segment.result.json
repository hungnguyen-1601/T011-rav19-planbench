              "kind": {
                "const": "trajectory_segment"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        }
      ],
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "trajectory_segment"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "measurements",
    "references"
  ],
  "title": "get_trajectory_segment@1.0.0 output",
  "type": "object"
