          "unit": "ratio"
        },
        "seeds_reaching_corridor": {
          "description": "Seeds whose tree reached it.",
          "type": "number",
          "unit": "count"
        },
        "seeds_run": {
          "description": "Seeds the corridor was attempted on.",
