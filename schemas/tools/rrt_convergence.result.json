{
  "$id": "schemas/tools/rrt_convergence.result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "measurements": {
      "additionalProperties": false,
      "properties": {
        "budget_multiplier": {
          "description": "The larger budget, as a multiple of configured.",
