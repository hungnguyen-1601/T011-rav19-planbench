# Load a scenario from the built-in library into the simulator node.
# The map and scenario come from planbench_benchmark.scenarios, so ROS
# and the headless benchmark run exactly the same geometry.

string scenario_name
int32 seed
---
bool success
string message
float64 start_x
float64 start_y
float64 start_theta
float64 goal_x
float64 goal_y
