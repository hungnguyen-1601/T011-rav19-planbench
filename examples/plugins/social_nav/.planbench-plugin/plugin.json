{
  "plugin_api": "1.1.0",
  "id": "org.planbench.example.social-nav",
  "version": "0.1.0",
  "role": "local",
  "runtime": {
    "supported_lanes": ["python_in_process"],
    "production_lane": "python_in_process",
    "profiles": {
      "python_in_process": {
        "protocol": "planbench-inproc/v1",
        "codec": "python-object/v1",
        "deadline_policy": "control-period",
        "entry_point": "social_nav:SocialNavPlanner"
      }
    }
  },
  "requirements": {
    "all_of": [
      "planbench://channel/legacy-observation@1",
      "human_state_estimates"
    ]
  },
  "supports": {
    "action_types": ["continuous-velocity@1"],
    "robot_dynamics": ["differential-drive@1"],
    "execution_models": ["synchronous-step@1"]
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "cruise_speed": {"type": "number"},
      "turn_gain": {"type": "number"}
    }
  },
  "requires_global_path": false
}
