# PlanBench — example environment file.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so
# never put a real key here.
#
#     cp .env.example .env
#
# ===================================================================
#  THE FIVE VARIABLES YOU NEED TO FILL IN
# ===================================================================
#
#  Everything else in this file has a working default. Fill these five,
#  run start.bat, and sign-in works — no code changes, no extra steps.
#
#      GOOGLE_CLIENT_ID
#      GOOGLE_CLIENT_SECRET
#      GITHUB_CLIENT_ID
#      GITHUB_CLIENT_SECRET
#      AUTH_SECRET
#
#  Register these exact callback URLs with the providers:
#
#      Google  http://localhost:8000/api/v1/auth/oauth/google/callback
#      GitHub  http://localhost:8000/api/v1/auth/oauth/github/callback
#
#  In production, replace http://localhost:8000 with the API's public
#  URL and set PLANBENCH_API_PUBLIC_URL to match — the app derives the
#  callback from it, so the two cannot drift apart.
#
#  Leaving Google or GitHub empty is fine: that button is not shown and
#  the rest of the site works. Leaving *all* of them empty is also fine
#  for local work — set PLANBENCH_ENABLE_DEV_LOGIN=true instead.
#
# ===================================================================

# ---------- Sign in with Google ----------
# https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Web application
#   → Authorised redirect URI: the Google URL above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Sign in with GitHub ----------
# https://github.com/settings/developers
#   → New OAuth App
#   → Authorization callback URL: the GitHub URL above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Session signing ----------
# Signs PlanBench's own tokens and the OAuth anti-CSRF cookie. Generate
# one and keep it out of version control:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Empty means a new random secret on every restart, which signs everyone
# out each time the API starts.
AUTH_SECRET=

# ---------- Development password login ----------
# Off by default. When true, the login page also offers a username and
# password form — useful before OAuth is configured, and never something
# to leave on in production.
PLANBENCH_ENABLE_DEV_LOGIN=false

# "nickname:role:password" entries, comma separated, used only when dev
# login is enabled. Role is "engineer" or "approver" — bare
# "nickname:password" also works and defaults to engineer. Empty
# generates one "developer" account (engineer) with a random password
# printed in the API log at startup.
#
# To test the approval gate locally without OAuth, seed one of each:
#   PLANBENCH_SEED_USERS=eng1:engineer:change-me,app1:approver:change-me
PLANBENCH_SEED_USERS=

# Nicknames and verified emails that get the admin flag, comma
# separated. Admin is not a benchmark role — it is a separate override
# used for recovery (unsticking a review whose reviewer has left) and,
# when PLANBENCH_ADMIN_OVERRIDE_ENABLED is also true, approving or
# rejecting a benchmark outside the normal Engineer/Approver flow.
# Every admin action is written to the audit trail under its own action
# name, distinct from an ordinary approval, so it is never mistaken for
# one.
PLANBENCH_ADMIN_NICKNAMES=
PLANBENCH_ADMIN_EMAILS=

# Off by default, like dev login — a solo developer with one admin
# account needs this to approve their own benchmarks locally without
# seeding a second Approver account. Leave off in any deployment with
# more than one real user: it is a bypass of separation of duties, not
# a substitute for it.
PLANBENCH_ADMIN_OVERRIDE_ENABLED=false

# Where the two halves of the app are reachable. The OAuth callback URL
# is derived from PLANBENCH_API_PUBLIC_URL, and the browser is sent back
# to PLANBENCH_WEB_APP_URL after signing in.
PLANBENCH_API_PUBLIC_URL=http://localhost:8000
PLANBENCH_WEB_APP_URL=http://localhost:3000

# ---------- Agent provider (M8) ----------
# auto | anthropic | openai | gemini | openrouter | groq | deepseek | xai | local | mock
#
# auto  : first provider whose key is set; deterministic mock if none.
# mock  : force the offline keyword-matching provider (no key, no network).
PLANBENCH_AGENT_PROVIDER=auto

# Required for every provider EXCEPT anthropic (which has a documented
# default). Model ids change often — check the provider's model list
# rather than trusting the suggestions below.
#
#   anthropic  : claude-opus-5              (default, may be omitted)
#   openai     : see https://platform.openai.com/docs/models
#   gemini     : see https://ai.google.dev/gemini-api/docs/models
#   openrouter : "<vendor>/<model>", see https://openrouter.ai/models
#   groq       : see https://console.groq.com/docs/models
#   deepseek   : deepseek-chat
#   xai        : see https://docs.x.ai/docs/models
#   local      : whatever your server serves (`ollama list`)
PLANBENCH_AGENT_MODEL=

# Only when pointing at a self-hosted server or a proxy. Empty uses the
# built-in endpoint for the selected provider.
PLANBENCH_AGENT_BASE_URL=

# Markdown directories indexed for retrieval (comma separated).
PLANBENCH_AGENT_KNOWLEDGE_DIRS=docs

# Ceiling on episodes the agent may propose in one benchmark.
PLANBENCH_AGENT_MAX_EPISODES=60

# ---------- Provider API keys ----------
# Paste the key for whichever provider you use; leave the rest empty.
# These are the providers' own variable names, not PlanBench settings.
#
# Requires the matching SDK. Ask before installing:
#   anthropic          -> .venv/bin/pip install anthropic
#   everything else    -> .venv/bin/pip install openai
#
# `local` needs no key: run Ollama or vLLM and set
# PLANBENCH_AGENT_PROVIDER=local plus PLANBENCH_AGENT_MODEL.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ---------- Persistence (M10) ----------
# Empty keeps everything in memory (lost on restart) — fine for
# development. Set a URL to use SQL:
#   postgresql://user:pass@host:5432/planbench   production
#   sqlite:///./planbench.db                     single process only
# docker compose sets this for the api container automatically.
# Unset here, scripts/dev_stack.sh defaults to a local SQLite file so
# accounts and benchmarks survive a restart. Set it to an empty string
# explicitly for the in-memory backend.
PLANBENCH_DATABASE_URL=
# Log every statement. Noisy; for debugging only.
PLANBENCH_DB_ECHO=false
# Create tables on startup instead of running Alembic. Throwaway SQLite
# only — a deployment migrates with `alembic upgrade head`.
PLANBENCH_DB_CREATE_ALL=false

# ---------- docker compose ----------
# Used by docker-compose.yml. Change the password before exposing the
# database port.
POSTGRES_USER=planbench
POSTGRES_PASSWORD=planbench
POSTGRES_DB=planbench
API_PORT=8000
WEB_PORT=3000
# Baked into the web bundle at build time: the URL the *browser* uses,
# so not the compose service name.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- API server ----------
# Legacy name for AUTH_SECRET, still read when AUTH_SECRET is empty so
# an existing deployment keeps working. New setups should use
# AUTH_SECRET at the top of this file.
PLANBENCH_JWT_SECRET=
PLANBENCH_JWT_TTL_MINUTES=60

PLANBENCH_ARTIFACT_DIR=artifacts
PLANBENCH_WORKER_CONCURRENCY=2
PLANBENCH_CORS_ORIGINS=["http://localhost:3000"]

# ---------- Experiment tracking ----------
# Empty disables tracking (null tracker). Use an http:// MLflow server in
# production; a file: URI works for local runs only.
PLANBENCH_MLFLOW_TRACKING_URI=
PLANBENCH_MLFLOW_EXPERIMENT=planbench
